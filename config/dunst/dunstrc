# dwm 会话通知（dunst）。安装：
#   pacman -S dunst libnotify
#   ln -sf ~/git/dotfiles/config/dunst/dunstrc ~/.config/dunst/dunstrc
# 测试：notify-send "dwm" "hello"

[global]
    monitor = 0
    follow = mouse
    width = (0, 360)
    offset = (12, 48)
    origin = top-right
    notification_limit = 5
    indicate_hidden = yes
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#0099ff"
    sort = yes
    font = monospace 12
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_dbusclose = no
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#222222"
    foreground = "#bbbbbb"
    frame_color = "#444444"
    timeout = 4

[urgency_normal]
    background = "#222222"
    foreground = "#eeeeee"
    frame_color = "#0099ff"
    timeout = 6

[urgency_critical]
    background = "#222222"
    foreground = "#eeeeee"
    frame_color = "#ff5555"
    timeout = 0
