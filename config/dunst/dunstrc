# dunst — X11/dwm 通知（由本机 mako 配置移植）
# 几何/超时对齐 config/mako/config；边框强调色用 dwm 选中色 #0099ff
# 安装：./install.sh dunst ；测试：notify-send "dwm" "hello"

[global]
    monitor = 0
    follow = mouse
    width = 350
    offset = (12, 12)
    origin = top-right
    notification_limit = 5
    indicate_hidden = yes
    gap_size = 6
    padding = 10
    horizontal_padding = 10
    frame_width = 2
    frame_color = "#0099ff"
    corner_radius = 4
    font = monospace 12
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle
    # 接近 mako ignore-timeout：用 urgency 段的 timeout，不依赖应用给的超时
    ignore_dbusclose = yes
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#222222"
    foreground = "#bbbbbb"
    frame_color = "#444444"
    timeout = 5

[urgency_normal]
    background = "#222222"
    foreground = "#eeeeee"
    frame_color = "#0099ff"
    timeout = 5

[urgency_critical]
    background = "#222222"
    foreground = "#eeeeee"
    frame_color = "#ff5555"
    timeout = 0
