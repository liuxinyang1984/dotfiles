#!/bin/sh
# rofi-drun — X11 应用启动（读 .desktop）
# dwm 默认：cde-dwm-drun.rasi（有图标）+ -normal-window
# run 用无图标的 cde-dwm.rasi；fvwm：ROFI_THEME=…/cde.rasi
set -e
ROFI_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/rofi"
THEME="${ROFI_THEME:-$ROFI_CONF/cde-dwm-drun.rasi}"
ICON_THEME="${ROFI_ICON_THEME:-Flat-Remix-Green-Light}"

if ! command -v rofi >/dev/null 2>&1; then
	command -v notify-send >/dev/null 2>&1 \
		&& notify-send -u critical 'rofi' '未安装 rofi（pacman -S rofi）'
	exit 1
fi

if [ ! -f "$THEME" ]; then
	command -v notify-send >/dev/null 2>&1 \
		&& notify-send -u critical 'rofi' "缺少主题 $THEME（./install.sh x11:rofi）"
	exit 1
fi

# 再按一次关掉已开的 rofi（与 dmenu-clip 开关习惯一致）
if [ -f /tmp/rofi-drun.pid ] && kill -0 "$(cat /tmp/rofi-drun.pid)" 2>/dev/null; then
	kill "$(cat /tmp/rofi-drun.pid)" 2>/dev/null || true
	exit 0
fi

exec rofi -normal-window -steal-focus \
	-pid /tmp/rofi-drun.pid \
	-show drun -show-icons \
	-icon-theme "$ICON_THEME" \
	-theme "$THEME" \
	"$@"
