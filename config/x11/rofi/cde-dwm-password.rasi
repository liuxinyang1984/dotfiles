/* 密码框：标题（-mesg）+ 输入栏，无列表（mini-polkit / pkexec） */
@import "cde-dwm.rasi"

configuration {
    show-icons: false;
}

mainbox {
    children: [ message, inputbar ];
    spacing:  4px;
}

message {
    background-color: #007070;
    border:           1px;
    border-color:     @border-color;
    border-radius:    0;
    padding:          4px 6px;
}

textbox {
    background-color: transparent;
    text-color:       #ffffff;
    horizontal-align: 0.0;
}

listview {
    enabled: false;
    lines:   0;
}

window {
    width: 360px;
}
