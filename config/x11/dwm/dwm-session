#!/bin/sh
# dwm 会话（已有 DISPLAY）。安装名: ~/.local/bin/dwm-session
#   dwm-session
#   startx dwm
#   startx ~/.local/bin/dwm-session

_common="${XDG_CONFIG_HOME:-$HOME/.config}/x11/session-common.sh"
if [ -f "$_common" ]; then
	# shellcheck source=/dev/null
	. "$_common"
else
	export PATH="${HOME}/.local/bin:/usr/local/bin:${PATH}"
	export GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx SDL_IM_MODULE=fcitx
fi
unset _common

if command -v feh >/dev/null 2>&1; then
	mkdir -p "$HOME/Pictures/wallpapers"
	if ls "$HOME/Pictures/wallpapers/"* >/dev/null 2>&1; then
		feh --bg-fill --randomize "$HOME/Pictures/wallpapers/"* &
	fi
fi

PICOM_BIN=""
if [ "${SKIP_PICOM:-0}" != 1 ]; then
	for c in "$HOME/.local/bin/picom" /usr/local/bin/picom; do
		[ -x "$c" ] && PICOM_BIN=$c && break
	done
fi

DWM_BIN=""
for c in "$HOME/.local/bin/dwm" /usr/local/bin/dwm; do
	[ -x "$c" ] && DWM_BIN=$c && break
done
[ -n "$DWM_BIN" ] || { echo "dwm not found in ~/.local/bin or /usr/local/bin" >&2; exit 1; }

# 空闲：screensaver 触发 xss-lock→slock；DPMS 单独灭屏（秒，可环境变量覆盖）
IDLE_LOCK_SEC="${IDLE_LOCK_SEC:-300}"   # 5 分钟锁屏
IDLE_DPMS_SEC="${IDLE_DPMS_SEC:-900}"   # 15 分钟灭屏
if command -v xset >/dev/null 2>&1; then
	xset s "$IDLE_LOCK_SEC" "$IDLE_LOCK_SEC"
	xset dpms "$IDLE_DPMS_SEC" "$IDLE_DPMS_SEC" "$IDLE_DPMS_SEC"
fi

# dwmblocks / fcitx5 / dunst / clipmenud / picom / xss-lock / mini-polkit 须在同一 dbus-run-session
# （blocks 在 session 外起则无 DBUS，sb-fcitx 的 fcitx5-remote 恒失败→永远「英」）
exec dbus-run-session -- sh -c "export PATH=\"${HOME}/.local/bin:\${PATH}\"; fcitx5 -d; if command -v dwmblocks >/dev/null 2>&1; then dwmblocks & fi; if command -v dunst >/dev/null 2>&1; then dunst & fi; if command -v clipmenud >/dev/null 2>&1; then clipmenud & fi; if command -v xss-lock >/dev/null 2>&1; then xss-lock -l -- slock & fi; if command -v mini-polkit-agent >/dev/null 2>&1; then mini-polkit-agent & elif command -v mini-polkit >/dev/null 2>&1; then mini-polkit \"dmenu -P -c -bw 2 -p Password:\" & fi; [ -n \"$PICOM_BIN\" ] && \"$PICOM_BIN\" --experimental-backends -b; exec \"$DWM_BIN\""
