#!/bin/sh
# 多启动包装 → ~/.local/bin/startx（须优先于 /usr/bin/startx）
#
#   startx              # 默认会话
#   startx dwm          # 若存在 dwm-session 则交给 ~/.xinitrc
#   startx fvwm
#   startx kiosk -- alacritty
#
# 规则：若 PATH 中存在「$1-session」，则把 $1 当作会话名；否则原样交给系统 startx。

export PATH="${HOME}/.local/bin:${PATH}"

if [ -n "${1:-}" ] && command -v "${1}-session" >/dev/null 2>&1; then
	session=$1
	shift
	[ "${1:-}" = "--" ] && shift
	exec /usr/bin/startx "$HOME/.xinitrc" "$session" "$@"
fi

exec /usr/bin/startx "$@"
