#!/bin/sh
# dotfiles-x11-session:1
# 多启动入口。落地：
#   ln -sf ~/git/dotfiles/config/x11/multistart/xinitrc ~/.xinitrc
#   install -m 755 …/multistart/startx ~/.local/bin/startx
#
#   startx | startx dwm | startx fvwm | startx kiosk | startx kiosk -- alacritty
#
# 依赖：kiosk → ./install.sh desktop:kiosk（config/x11/kiosk）
#       dwm   → ./install.sh desktop:suckless（+ 可选 x11:picom）
#       fvwm  → ./install.sh desktop:fvwm（vendor/fvwm → ~/.fvwm）

userresources=$HOME/.Xresources
usermodmap=$HOME/.Xmodmap
sysresources=/etc/X11/xinit/.Xresources
sysmodmap=/etc/X11/xinit/.Xmodmap

[ -f "$sysresources" ] && xrdb -merge "$sysresources"
[ -f "$sysmodmap" ] && xmodmap "$sysmodmap"
[ -f "$userresources" ] && xrdb -merge "$userresources"
[ -f "$usermodmap" ] && xmodmap "$usermodmap"

if [ -d /etc/X11/xinit/xinitrc.d ]; then
	for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
		[ -x "$f" ] && . "$f"
	done
	unset f
fi

# 安装时写入的默认会话（无运行时探测已装桌面）
DEFAULT_SESSION=kiosk
_def_file="${XDG_CONFIG_HOME:-$HOME/.config}/x11/default-session"
if [ -f "$_def_file" ]; then
	_line="$(sed -n '1p' "$_def_file" | tr -d '\r' | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//')"
	case "$_line" in
	kiosk|dwm|fvwm) DEFAULT_SESSION=$_line ;;
	esac
	unset _line
fi
unset _def_file
session=${1:-$DEFAULT_SESSION}
[ $# -gt 0 ] && shift
[ "${1:-}" = "--" ] && shift

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
	export XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)"
	mkdir -p "$XDG_RUNTIME_DIR"
	chmod 700 "$XDG_RUNTIME_DIR"
fi

case "$session" in
kiosk)
	exec "$HOME/.local/bin/kiosk-session.sh" "$@"
	;;
fvwm)
	export PATH="${HOME}/.local/bin:${PATH}"
	export GTK_IM_MODULE=fcitx
	export QT_IM_MODULE=fcitx
	export XMODIFIERS=@im=fcitx
	export SDL_IM_MODULE=fcitx
	if [ ! -f "${HOME}/.fvwm/config" ]; then
		echo "缺少 ~/.fvwm/config；请先: ./install.sh desktop:fvwm" >&2
		exit 1
	fi
	command -v fvwm3 >/dev/null 2>&1 || { echo "fvwm3 not found" >&2; exit 1; }
	# fcitx5 / 壁纸由 ~/.fvwm 内 autostart 拉起
	exec dbus-run-session -- fvwm3
	;;
dwm)
	# SSH / 非登录壳常无 ~/.local/bin；个人安装的 dwm、dwmblocks、picom 都在这
	export PATH="${HOME}/.local/bin:${PATH}"
	export GTK_IM_MODULE=fcitx
	export QT_IM_MODULE=fcitx
	export XMODIFIERS=@im=fcitx
	export SDL_IM_MODULE=fcitx
	# dwmblocks-async（二进制名仍为 dwmblocks）；勿与 slstatus 叠跑
	command -v dwmblocks >/dev/null 2>&1 && dwmblocks &
	if command -v feh >/dev/null 2>&1; then
		mkdir -p "$HOME/Pictures/wallpapers"
		if ls "$HOME/Pictures/wallpapers/"* >/dev/null 2>&1; then
			feh --bg-fill --randomize "$HOME/Pictures/wallpapers/"* &
		fi
	fi
	# 自编译 picom（/usr/local 或 ~/.local）；v9 需 --experimental-backends（dual_kawase 等）
	# SKIP_PICOM=1 时不启动（SSH -Y / Xephyr 转发桌面很卡）
	PICOM_BIN=""
	if [ "${SKIP_PICOM:-0}" != 1 ]; then
		for c in "$HOME/.local/bin/picom" /usr/local/bin/picom; do
			[ -x "$c" ] && PICOM_BIN=$c && break
		done
	fi
	DWM_BIN=""
	for c in "$HOME/.local/bin/dwm" /usr/local/bin/dwm; do
		[ -x "$c" ] && DWM_BIN=$c && break
	done
	[ -n "$DWM_BIN" ] || { echo "dwm not found in ~/.local/bin or /usr/local/bin" >&2; exit 1; }
	# dunst / clipmenud 须在同一 dbus-run-session 内；注意 sh 不能写 `cmd &;`（& 后接 ; 会语法错误）
	# clipmenud：为 Mod+v（dmenu-clip）积累历史，依赖 clipmenu + xclip
	exec dbus-run-session -- sh -c "export PATH=\"${HOME}/.local/bin:\${PATH}\"; fcitx5 -d; if command -v dunst >/dev/null 2>&1; then dunst & fi; if command -v clipmenud >/dev/null 2>&1; then clipmenud & fi; [ -n \"$PICOM_BIN\" ] && \"$PICOM_BIN\" --experimental-backends -b; exec \"$DWM_BIN\""
	;;
*)
	echo "unknown session: $session (kiosk|dwm|fvwm)" >&2
	exit 1
	;;
esac
