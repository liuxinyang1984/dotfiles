#!/bin/sh
# dotfiles-x11-session:1
# 多启动：只做 xrdb + 按「${session}-session」查找命令并 exec（无会话白名单）。
#
#   startx           → 默认会话名（default-session 文件或内置）
#   startx dwm       → exec dwm-session …
#   startx fvwm      → exec fvwm-session …
#   startx kiosk -- alacritty → exec kiosk-session alacritty
#
# 会话脚本由各 desktop:* 安装到 ~/.local/bin。

userresources=$HOME/.Xresources
usermodmap=$HOME/.Xmodmap
sysresources=/etc/X11/xinit/.Xresources
sysmodmap=/etc/X11/xinit/.Xmodmap

[ -f "$sysresources" ] && xrdb -merge "$sysresources"
[ -f "$sysmodmap" ] && xmodmap "$sysmodmap"
[ -f "$userresources" ] && xrdb -merge "$userresources"
[ -f "$usermodmap" ] && xmodmap "$usermodmap"

if [ -d /etc/X11/xinit/xinitrc.d ]; then
	for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
		[ -x "$f" ] && . "$f"
	done
	unset f
fi

DEFAULT_SESSION=kiosk
_def_file="${XDG_CONFIG_HOME:-$HOME/.config}/x11/default-session"
if [ -f "$_def_file" ]; then
	_line="$(sed -n '1p' "$_def_file" | tr -d '\r' | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//')"
	[ -n "$_line" ] && DEFAULT_SESSION=$_line
	unset _line
fi
unset _def_file

session=${1:-$DEFAULT_SESSION}
[ $# -gt 0 ] && shift
[ "${1:-}" = "--" ] && shift

export PATH="${HOME}/.local/bin:${PATH}"

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
	export XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)"
	mkdir -p "$XDG_RUNTIME_DIR"
	chmod 700 "$XDG_RUNTIME_DIR"
fi

cmd="${session}-session"
if ! command -v "$cmd" >/dev/null 2>&1; then
	echo "session command not found: $cmd（请先安装对应 desktop，或检查 ~/.local/bin）" >&2
	exit 1
fi
exec "$cmd" "$@"
